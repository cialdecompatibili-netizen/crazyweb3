{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid %}
      {% endif %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

{% comment %} MODULI: aggancio 'footer' (HTML dei moduli attivi, in fondo al body). Vedi modules_hook.liquid. Se togli questa riga i moduli con hook footer spariscono dal sito. {% endcomment %}
{% include modules_hook.liquid hook='footer' %}

<!-- Bottoni flottanti: torna-su (in alto) + WhatsApp DEMO (sotto), sempre sopra il footer fisso -->
<style>
  :root { --footer-h: 40px; }
  #whatsapp-demo-btn {
    position: fixed;
    right: 30px;
    bottom: calc(var(--footer-h) + 12px);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.26);
    cursor: default;
    z-index: 1031;
    border: 0;
    padding: 0;
  }
  #whatsapp-demo-btn svg { width: 22px; height: 22px; fill: currentColor; }
  #back-to-top {
    z-index: 1031 !important;
    right: 30px !important;
    bottom: calc(var(--footer-h) + 62px) !important;
  }
  #back-to-top.hidden {
    bottom: -100px !important;
  }
</style>
<button id="whatsapp-demo-btn" type="button" aria-label="WhatsApp (demo)" title="WhatsApp (demo, non attivo)" onclick="return false;">
  <svg viewBox="0 0 448 512" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
</button>
<script>
  // Misura l'altezza reale del footer (cambia su mobile quando il testo va a capo)
  (function () {
    function setFooterH() {
      var f = document.querySelector('footer.fixed-bottom');
      var h = f ? f.offsetHeight : 0;
      document.documentElement.style.setProperty('--footer-h', h + 'px');
    }
    window.addEventListener('load', setFooterH);
    window.addEventListener('resize', setFooterH);
    setFooterH();
  })();
</script>
{% comment %} MODULI: aggancio 'footer' (JS/HTML dei moduli attivi, fine pagina). Vedi modules_hook.liquid. Se togli questa riga i moduli con hook footer non caricano piu' nulla. {% endcomment %}
{% include modules_hook.liquid hook='footer' %}
