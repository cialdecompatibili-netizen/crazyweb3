<?xml version="1.0" encoding="utf-8"?><feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en"><generator uri="https://jekyllrb.com/" version="4.4.1">Jekyll</generator><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/feed.xml" rel="self" type="application/atom+xml"/><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/" rel="alternate" type="text/html" hreflang="en"/><updated>2026-09-20T21:19:14+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/feed.xml</id><title type="html">blank</title><subtitle>A simple, whitespace theme for academics. Based on [*folio](https://github.com/bogoli/-folio) design. </subtitle><entry><title type="html">clubber</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/clubber/" rel="alternate" type="text/html" title="clubber"/><published>2026-09-20T19:59:00+02:00</published><updated>2026-09-20T19:59:00+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/clubber</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/clubber/"><![CDATA[<p>clubber</p>]]></content><author><name></name></author><category term="sample-posts"/><summary type="html"><![CDATA[clubber]]></summary></entry><entry><title type="html">ultimox</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/ultimox/" rel="alternate" type="text/html" title="ultimox"/><published>2026-09-20T18:13:00+02:00</published><updated>2026-09-20T18:13:00+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/ultimox</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/ultimox/"><![CDATA[<ul> <li>ultimox</li> </ul>]]></content><author><name></name></author><category term="sample-posts"/><summary type="html"><![CDATA[ultimox]]></summary></entry><entry><title type="html">Francesco</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/francesco/" rel="alternate" type="text/html" title="Francesco"/><published>2026-09-20T17:56:00+02:00</published><updated>2026-09-20T17:56:00+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/francesco</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/francesco/"><![CDATA[<p>Francesco <strong>corpo</strong></p>]]></content><author><name></name></author><category term="sample-posts"/><summary type="html"><![CDATA[Francesco]]></summary></entry><entry><title type="html">mmmmm</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/mmmmm/" rel="alternate" type="text/html" title="mmmmm"/><published>2026-09-20T17:35:00+02:00</published><updated>2026-09-20T17:35:00+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/mmmmm</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/mmmmm/"><![CDATA[<ul> <li>mmmmm</li> </ul>]]></content><author><name></name></author><category term="sample-posts"/><category term="mmmmm"/><summary type="html"><![CDATA[mmmmm]]></summary></entry><entry><title type="html">esempiox</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/esempiox/" rel="alternate" type="text/html" title="esempiox"/><published>2026-09-20T17:06:00+02:00</published><updated>2026-09-20T17:06:00+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/esempiox</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/esempiox/"><![CDATA[<p><strong>esempiox</strong></p>]]></content><author><name></name></author><category term="sample-posts"/><summary type="html"><![CDATA[esempiox]]></summary></entry><entry><title type="html">nuovo post prova</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/nuovo-post-prova/" rel="alternate" type="text/html" title="nuovo post prova"/><published>2026-09-20T16:47:00+02:00</published><updated>2026-09-20T16:47:00+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/nuovo-post-prova</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/nuovo-post-prova/"><![CDATA[<ul> <li>ciao esterno</li> </ul>]]></content><author><name></name></author><category term="external-services"/><summary type="html"><![CDATA[prova prova]]></summary></entry><entry><title type="html">facciata</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/facciata/" rel="alternate" type="text/html" title="facciata"/><published>2026-09-19T17:25:00+02:00</published><updated>2026-09-19T17:25:00+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/facciata</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2026/facciata/"><![CDATA[<p><strong>sa</strong></p>]]></content><author><name></name></author><category term="sample-posts"/><category term="sa"/><summary type="html"><![CDATA[sa]]></summary></entry><entry><title type="html">a post with marimo snippets</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2025/marimo/" rel="alternate" type="text/html" title="a post with marimo snippets"/><published>2025-04-28T14:00:00+02:00</published><updated>2025-04-28T14:00:00+02:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2025/marimo</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2025/marimo/"><![CDATA[<p><a href="https://marimo.io">marimo</a> notebooks can run Python directly in the reader’s browser. Opt a page in from its front matter:</p> <div class="language-yaml highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="nn">---</span>
<span class="na">layout</span><span class="pi">:</span> <span class="s">post</span>
<span class="na">title</span><span class="pi">:</span> <span class="s">a post with marimo snippets</span>
<span class="na">marimo</span><span class="pi">:</span> <span class="kc">true</span>
<span class="nn">---</span>
</code></pre></div></div> <p>Nothing is loaded on pages without that flag, so bundling the plugin costs nothing site-wide.</p> <h2 id="runnable-snippets">Runnable snippets</h2> <p>Wrap fenced Python blocks in a container and the runtime turns them into an interactive notebook after the page loads:</p> <div class="al-marimo-inline"> <div class="language-python highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="kn">import</span> <span class="n">marimo</span> <span class="k">as</span> <span class="n">mo</span>

<span class="n">slider</span> <span class="o">=</span> <span class="n">mo</span><span class="p">.</span><span class="n">ui</span><span class="p">.</span><span class="nf">slider</span><span class="p">(</span><span class="mi">1</span><span class="p">,</span> <span class="mi">20</span><span class="p">,</span> <span class="n">value</span><span class="o">=</span><span class="mi">5</span><span class="p">,</span> <span class="n">label</span><span class="o">=</span><span class="sh">"</span><span class="s">n</span><span class="sh">"</span><span class="p">)</span>
<span class="n">slider</span>
</code></pre></div> </div> <div class="language-python highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="n">mo</span><span class="p">.</span><span class="nf">md</span><span class="p">(</span><span class="sa">f</span><span class="sh">"</span><span class="s">The first </span><span class="si">{</span><span class="n">slider</span><span class="p">.</span><span class="n">value</span><span class="si">}</span><span class="s"> squares: </span><span class="si">{</span><span class="p">[</span><span class="n">i</span><span class="o">**</span><span class="mi">2</span> <span class="k">for</span> <span class="n">i</span> <span class="ow">in</span> <span class="nf">range</span><span class="p">(</span><span class="mi">1</span><span class="p">,</span> <span class="n">slider</span><span class="p">.</span><span class="n">value</span> <span class="o">+</span> <span class="mi">1</span><span class="p">)]</span><span class="si">}</span><span class="sh">"</span><span class="p">)</span>
</code></pre></div> </div> </div> <p>Until the runtime has moved those blocks into place the container stays hidden, so readers never see the raw source flash before it becomes a notebook.</p> <h2 id="embedding-a-hosted-notebook">Embedding a hosted notebook</h2> <p>If you already publish a notebook — on <code class="language-plaintext highlighter-rouge">marimo.app</code> or your own WASM host — embed it instead:</p> <div class="language-liquid highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="cp">{%</span><span class="w"> </span><span class="nt">al_marimo_embed</span><span class="w"> </span><span class="na">src</span><span class="o">=</span><span class="s2">"https://marimo.app/l/your-notebook"</span><span class="w"> </span><span class="na">height</span><span class="o">=</span><span class="s2">"700px"</span><span class="w"> </span><span class="na">caption</span><span class="o">=</span><span class="s2">"Sampling demo"</span><span class="w"> </span><span class="cp">%}</span>
</code></pre></div></div> <p>The frame is sandboxed <strong>without</strong> <code class="language-plaintext highlighter-rouge">allow-same-origin</code>, so the embedded notebook cannot reach this page’s storage or cookies.</p> <h2 id="a-note-on-what-this-loads">A note on what this loads</h2> <p>The <code class="language-plaintext highlighter-rouge">marimo-snippets</code> runtime is vendored into the plugin at a pinned version and served from your own site, rather than pulled from a CDN — so no third-party origin executes script in your readers’ pages. Running a notebook does contact marimo’s host, which is worth knowing before you opt a page in.</p>]]></content><author><name></name></author><category term="sample-posts"/><category term="code"/><category term="formatting"/><summary type="html"><![CDATA[running Python in the browser with marimo]]></summary></entry><entry><title type="html">a post with plotly.js</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2025/plotly/" rel="alternate" type="text/html" title="a post with plotly.js"/><published>2025-03-26T15:24:00+01:00</published><updated>2025-03-26T15:24:00+01:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2025/plotly</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2025/plotly/"><![CDATA[<p>This is an example post with some <a href="https://plotly.com/javascript/">plotly</a> code.</p> <div class="language-markdown highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="p">```</span><span class="nl">plotly
</span><span class="sb">{
  "data": [
    {
      "x": [1, 2, 3, 4],
      "y": [10, 15, 13, 17],
      "type": "scatter"
    },
    {
      "x": [1, 2, 3, 4],
      "y": [16, 5, 11, 9],
      "type": "scatter"
    }
  ]
}</span>
<span class="p">```</span>
</code></pre></div></div> <p>Which generates:</p> <pre><code class="language-plotly">{
  "data": [
    {
      "x": [1, 2, 3, 4],
      "y": [10, 15, 13, 17],
      "type": "scatter"
    },
    {
      "x": [1, 2, 3, 4],
      "y": [16, 5, 11, 9],
      "type": "scatter"
    }
  ]
}
</code></pre> <p>Also another example chart.</p> <div class="language-markdown highlighter-rouge"><div class="highlight"><pre class="highlight"><code><span class="p">```</span><span class="nl">plotly
</span><span class="sb">{
  "data": [
    {
      "x": [1, 2, 3, 4],
      "y": [10, 15, 13, 17],
      "mode": "markers"
    },
    {
      "x": [2, 3, 4, 5],
      "y": [16, 5, 11, 9],
      "mode": "lines"
    },
    {
      "x": [1, 2, 3, 4],
      "y": [12, 9, 15, 12],
      "mode": "lines+markers"
    }
  ],
  "layout": {
    "title": {
      "text": "Line and Scatter Plot"
    }
  }
}</span>
<span class="p">```</span>
</code></pre></div></div> <p>This is how it looks like:</p> <pre><code class="language-plotly">{
  "data": [
    {
      "x": [1, 2, 3, 4],
      "y": [10, 15, 13, 17],
      "mode": "markers"
    },
    {
      "x": [2, 3, 4, 5],
      "y": [16, 5, 11, 9],
      "mode": "lines"
    },
    {
      "x": [1, 2, 3, 4],
      "y": [12, 9, 15, 12],
      "mode": "lines+markers"
    }
  ],
  "layout": {
    "title": {
      "text": "Line and Scatter Plot"
    }
  }
}
</code></pre>]]></content><author><name></name></author><category term="sample-posts"/><category term="formatting"/><category term="charts"/><summary type="html"><![CDATA[this is what included plotly.js code could look like]]></summary></entry><entry><title type="html">a post with image galleries</title><link href="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2024/photo-gallery/" rel="alternate" type="text/html" title="a post with image galleries"/><published>2024-12-04T02:59:00+01:00</published><updated>2024-12-04T02:59:00+01:00</updated><id>https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2024/photo-gallery</id><content type="html" xml:base="https://cialdecompatibili-netizen.github.io/crazyweb3/blog/2024/photo-gallery/"><![CDATA[<p>The images in this post are all zoomable, arranged into different mini-galleries using different libraries.</p> <h2 id="lightbox2">Lightbox2</h2> <p><a href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/1/img-2500.jpg" data-lightbox="roadtrip"><img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/1/img-200.jpg"/></a> <a href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/2/img-2500.jpg" data-lightbox="roadtrip"><img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/2/img-200.jpg"/></a> <a href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/3/img-2500.jpg" data-lightbox="roadtrip"><img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/3/img-200.jpg"/></a></p> <hr/> <h2 id="photoswipe"><a href="https://photoswipe.com/">PhotoSwipe</a></h2> <div class="pswp-gallery pswp-gallery--single-column" id="gallery--getting-started"> <a href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/2/img-2500.jpg" data-pswp-width="1669" data-pswp-height="2500" target="_blank"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/2/img-200.jpg" alt=""/> </a> <a href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/7/img-2500.jpg" data-pswp-width="1875" data-pswp-height="2500" data-cropped="true" target="_blank"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/7/img-200.jpg" alt=""/> </a> <a href="https://unsplash.com" data-pswp-src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/3/img-2500.jpg" data-pswp-width="2500" data-pswp-height="1666" target="_blank"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/3/img-200.jpg" alt=""/> </a> <div> <a href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/6/img-2500.jpg" data-pswp-width="2500" data-pswp-height="1667" target="_blank"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/6/img-200.jpg" alt=""/> </a> </div> </div> <hr/> <h2 id="spotlight-js"><a href="https://nextapps-de.github.io/spotlight/">Spotlight JS</a></h2> <div class="spotlight-group"> <a class="spotlight" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/1/img-2500.jpg"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/1/img-200.jpg"/> </a> <a class="spotlight" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/2/img-2500.jpg"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/2/img-200.jpg"/> </a> <a class="spotlight" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/3/img-2500.jpg"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/3/img-200.jpg"/> </a> </div> <div class="spotlight-group"> <a class="spotlight" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/4/img-2500.jpg"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/4/img-200.jpg"/> </a> <a class="spotlight" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/5/img-2500.jpg"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/5/img-200.jpg"/> </a> <a class="spotlight" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/6/img-2500.jpg"> <img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/6/img-200.jpg"/> </a> </div> <hr/> <h2 id="venobox"><a href="https://veno.es/venobox/">Venobox</a></h2> <p><a class="venobox" data-gall="myGallery" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/1/img-2500.jpg"><img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/1/img-200.jpg"/></a> <a class="venobox" data-gall="myGallery" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/2/img-2500.jpg"><img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/2/img-200.jpg"/></a> <a class="venobox" data-gall="myGallery" href="https://cdn.photoswipe.com/photoswipe-demo-images/photos/3/img-2500.jpg"><img src="https://cdn.photoswipe.com/photoswipe-demo-images/photos/3/img-200.jpg"/></a></p>]]></content><author><name></name></author><category term="sample-posts"/><category term="formatting"/><category term="images"/><summary type="html"><![CDATA[this is what included image galleries could look like]]></summary></entry></feed>